From 4cac649b360ce5ce65c9db5dbad190f7e15513dd Mon Sep 17 00:00:00 2001
From: Andy Piper
Date: Fri, 20 Nov 2026 16:49:42 +0000
Subject: [PATCH 1/2] AP_Scripting: test indexing binding objects twice

scripting_test.lua checks that the first lookup of a name on a binding
and later lookups agree, on another object of the same type too, for
userdata, a singleton and an ap_object; that two types or two singletons
with a method of the same name do not share it; that an enum value reads
the same twice; and that an unknown name or a numeric key stays nil.

It checks once, on names nothing else in the file looks up, and keeps
the result, so a wrong first lookup is not hidden by later runs passing.
It passes on master.
---
 .../AP_Scripting/tests/scripting_test.lua     | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/libraries/AP_Scripting/tests/scripting_test.lua b/libraries/AP_Scripting/tests/scripting_test.lua
index 741d852c39..0c5d253425 100644
--- a/libraries/AP_Scripting/tests/scripting_test.lua
+++ b/libraries/AP_Scripting/tests/scripting_test.lua
@@ -63,6 +63,43 @@ function test_uint64()
   return pass
 end
 
+local index_checked, index_passed = false, false
+
+function test_index()
+  -- the first lookup of a name on a binding and later ones agree, and types with a method of the
+  -- same name keep their own. Checked once, on names nothing else here looks up, so a later pass
+  -- cannot hide a failure
+  if index_checked then
+    return index_passed
+  end
+  index_checked = true
+  local v3, v3_other, v2 = Vector3f(), Vector3f(), Vector2f()
+  local ch1, ch2 = assert(rc:get_channel(1)), assert(rc:get_channel(2))
+  v3_other:x(2)
+  local is_zero, healthy, norm_input, fix_3d = v3.is_zero, ahrs.healthy, ch1.norm_input, gps.GPS_OK_FIX_3D
+  for _ = 1, 2 do
+    if v3_other.is_zero ~= is_zero or ahrs.healthy ~= healthy or ch2.norm_input ~= norm_input or
+       not is_zero(v3) or is_zero(v3_other) then
+      gcs:send_text(0, "Failed: a method lookup gave the wrong function")
+      return false
+    end
+    if v2.is_zero == is_zero or baro.healthy == healthy then
+      gcs:send_text(0, "Failed: a method is shared between types")
+      return false
+    end
+    if gps.GPS_OK_FIX_3D ~= fix_3d or fix_3d ~= 3 then
+      gcs:send_text(0, "Failed: wrong enum value")
+      return false
+    end
+    if ahrs.no_such_method ~= nil or v3[1] ~= nil then -- luacheck: ignore 143
+      gcs:send_text(0, "Failed: an unknown name gave a value")
+      return false
+    end
+  end
+  index_passed = true
+  return true
+end
+
 function update()
   local all_tests_passed = true
   local require_test_local = require('test/nested')
@@ -82,6 +119,7 @@ function update()
   -- each test should run then and it's result with the previous ones
   all_tests_passed = test_offset(500, 200) and all_tests_passed
   all_tests_passed = test_uint64() and all_tests_passed
+  all_tests_passed = test_index() and all_tests_passed
 
   if all_tests_passed then
     gcs:send_text(3, "Internal tests passed")
-- 
2.43.0


From 2a61e3d551452cc3dcca36b566349b24380502ec Mon Sep 17 00:00:00 2001
From: Andy Piper
Date: Fri, 20 Nov 2026 16:49:42 +0000
Subject: [PATCH 2/2] AP_Scripting: cache binding method lookups

Every obj:method() call went through the type's __index C function,
which compared the name against the type's method list one strcmp at a
time, on every call. On an RP2350 a 50 Hz script making about 45 binding
calls a run spent a tenth of its CPU there.

Each type's __index is now a table that caches what the index function
finds, with a shared metatable that calls the function on a miss and
keeps the answer when it is not nil, so a cache holds at most its type's
methods and enums. A method is looked up by name once per type, and
later calls are a table hit inside the VM, with no C call. The same
script's thread went from 10.3% to 8.5% of its core, and the caches took
1.6 KB of Lua heap for about 30 methods over 16 types.

The first lookup of a name can now allocate, so it can fail when the
scripting heap is full. The cache is the metatable's last setup step,
so a failure there leaves the type working, uncached.
---
 .../generator/gen/generated_cpp_loader.h      | 45 +++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/libraries/AP_Scripting/generator/gen/generated_cpp_loader.h b/libraries/AP_Scripting/generator/gen/generated_cpp_loader.h
index 67c007b0b4..dbc60f9f6d 100644
--- a/libraries/AP_Scripting/generator/gen/generated_cpp_loader.h
+++ b/libraries/AP_Scripting/generator/gen/generated_cpp_loader.h
@@ -2,6 +2,48 @@
 
 // for inclusion at the end of the generated .cpp
 
+// its address is a key no script can form, and not const so no build merges it with another
+// constant: in the registry it holds the metatable shared by the method caches, and in each
+// cache the index function the cache loads from
+static char index_cache_key;
+
+// __index of a method cache: look the name up with the cache's index function and keep a hit.
+// Misses are not kept, so a cache holds at most its type's methods and enums
+static int index_cache_miss(lua_State *L) {
+    // a bad key fails here, where the error names __index as it did before the cache
+    luaL_checkstring(L, 2);
+    lua_rawgetp(L, 1, &index_cache_key);
+    lua_pushvalue(L, 1);
+    lua_pushvalue(L, 2);
+    lua_call(L, 2, 1);
+    if (!lua_isnil(L, -1)) {
+        lua_pushvalue(L, 2);
+        lua_pushvalue(L, -2);
+        lua_rawset(L, 1);
+    }
+    return 1;
+}
+
+// replace the __index function of the metatable on top of the stack with a cache of what it
+// finds, so a method is looked up by name once rather than on every call. Right only while an
+// index function's answer depends on the name alone, never the object, as the generated ones
+// do. A metatable's last step, so a failed allocation here leaves it complete and uncached
+static void cache_index(lua_State *L) {
+    lua_createtable(L, 0, 1);
+    lua_getfield(L, -2, "__index");
+    lua_rawsetp(L, -2, &index_cache_key);
+    if (lua_rawgetp(L, LUA_REGISTRYINDEX, &index_cache_key) == LUA_TNIL) {
+        lua_pop(L, 1);
+        lua_createtable(L, 0, 1);
+        lua_pushcfunction(L, index_cache_miss);
+        lua_setfield(L, -2, "__index");
+        lua_pushvalue(L, -1);
+        lua_rawsetp(L, LUA_REGISTRYINDEX, &index_cache_key);
+    }
+    lua_setmetatable(L, -2);
+    lua_setfield(L, -2, "__index");
+}
+
 void * new_ap_object(lua_State *L, size_t size, const char * name) {
     void * ud = lua_newuserdata(L, size);
     if (luaL_newmetatable(L, name)) { // metatable just created, set it up
@@ -9,6 +51,7 @@ void * new_ap_object(lua_State *L, size_t size, const char * name) {
             if (strcmp(name, ap_object_fun[i].name) == 0) {
                 lua_pushcfunction(L, ap_object_fun[i].func);
                 lua_setfield(L, -2, "__index");
+                cache_index(L);
                 break;
             }
         }
@@ -30,6 +73,7 @@ void set_userdata_metatable(lua_State *L, const char * name) {
                 if (userdata_fun[i].operators != nullptr) {
                     luaL_setfuncs(L, userdata_fun[i].operators, 0);
                 }
+                cache_index(L);
                 break;
             }
         }
@@ -51,6 +95,7 @@ static int binding_index(lua_State *L) {
             if (luaL_newmetatable(L, name)) { // need to create metatable
                 lua_pushcfunction(L, singleton_fun[i].func);
                 lua_setfield(L, -2, "__index");
+                cache_index(L);
             }
             lua_setmetatable(L, -2);
             found = true;
-- 
2.43.0

