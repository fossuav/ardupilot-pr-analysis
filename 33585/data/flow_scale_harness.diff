+    def flow_scale_probe(self, rng_scaling):
+        """Fly two straight legs with the EKF's flow scale height wrong by a known factor.
+
+        RNGFND1_SCALING is doubled so the range finder reports twice the true distance:
+        the terrain estimator then places the ground twice as far below the vehicle, and
+        heightAboveGndEst (terrainState - pd, logged as XKF5.HAGL) is that wrong height.
+        Leg 1 flies with the range finder in range, leg 2 above its range where the
+        flat-ground assumption holds the frozen (wrong) datum. Nothing asserts; the run
+        is the measurement.
+        """
+        self.set_parameters({
+            "SIM_FLOW_ENABLE": 1,
+            "FLOW_TYPE": 10,
+            "EK3_IMU_MASK": 1,
+            "AVOID_ENABLE": 0,
+            "TERRAIN_ENABLE": 0,
+            "EK3_OPTIONS": 1 << 5,
+            "EK3_SRC1_POSZ": 1,
+        })
+        self.set_analog_rangefinder_parameters()
+        self.set_parameters({
+            "RNGFND1_MAX": 15,
+            "RNGFND1_SCALING": rng_scaling,
+        })
+        self.configure_EKFs_to_use_optical_flow_instead_of_GPS()
+        self.reboot_sitl()
+        self.wait_ready_to_arm(require_absolute=False)
+        self.takeoff(5, mode="ALT_HOLD", require_absolute=False)
+        self.delay_sim_time(3)
+        # leg 1: range finder in range, scale height wrong by the scaling factor
+        self.set_rc(2, 1300)
+        self.delay_sim_time(14)
+        self.set_rc(2, 1500)
+        self.delay_sim_time(4)
+        # climb clear of the reported range so the datum freezes and the flat-ground
+        # assumption is what keeps flow nav valid
+        self.set_rc(3, 1800)
+        self.wait_altitude(13, 17, relative=True, timeout=60)
+        self.set_rc(3, 1500)
+        self.delay_sim_time(8)
+        # leg 2: same input, on the frozen datum
+        self.set_rc(2, 1300)
+        self.delay_sim_time(14)
+        self.set_rc(2, 1500)
+        self.delay_sim_time(3)
+        self.disarm_vehicle(force=True)
+
+    def FlowScaleProbeGood(self):
+        '''control: flow scale height correct'''
+        self.flow_scale_probe(12.12)
+
+    def FlowScaleProbeBad(self):
+        '''provocation: flow scale height twice the truth'''
+        self.flow_scale_probe(24.24)
+
     def EK3_OptflowAssumeFlatGnd(self):
