From 2e7606da05316e19c73b7676118d209643d869a4 Mon Sep 17 00:00:00 2001
From: Andy Piper <github@andypiper.com>
Date: Wed, 4 Nov 2026 12:26:43 +0000
Subject: [PATCH] autotest: measure a flow lane's recovery after banked turns
 and flips

A measurement harness, not a pass/fail check. Core 0 on GPS flies the
vehicle while core 1 on optical flow alone dead-reckons through banked
turns of 3, 8 and 15 s past the flow tilt limit, and through one and
three flips, at 12 m and 30 m. The legs are flown with a yaw source for
the flow core, without one, and with a 3% gyro scale error.

For each leg it reads the log and reports the flow core's velocity
error against SITL truth as the vehicle levels and 2, 5 and 10 s later,
whether the first returning flow sample passed the innovation gate and
how long until one did, and any flow timeouts. Rows are appended to
OpticalFlowTiltRecovery.csv in the build logs, labelled by
TILT_RECOVERY_TAG. The gate figures need XKF5 for the flow core, which
EKF3 logs only for the primary core.
---
 Tools/autotest/arducopter.py | 290 +++++++++++++++++++++++++++++++++++
 1 file changed, 290 insertions(+)

diff --git a/Tools/autotest/arducopter.py b/Tools/autotest/arducopter.py
index 244037e41a..f9c68eb369 100644
--- a/Tools/autotest/arducopter.py
+++ b/Tools/autotest/arducopter.py
@@ -22,6 +22,7 @@ import xml.etree.ElementTree as ET
 
 import numpy
 
+from pymavlink import DFReader
 from pymavlink import mavextra
 from pymavlink import mavftp_op
 from pymavlink import mavutil
@@ -4429,6 +4430,294 @@ class AutoTestCopter(vehicle_test_suite.TestSuite):
 
         self.do_RTL()
 
+    def flow_tilt_recovery_figures(self, path, legs, core=1):
+        '''for each leg, how the flow core recovered once the vehicle levelled.
+        A stretch is a run of the core's own attitude past EKF3's flow tilt
+        limit (cos(roll)cos(pitch) <= 0.71); a leg runs from its first stretch
+        to the end of its last, and its tilt is their total.  A flow
+        update is an XKF5 record whose innovations changed, and it passed the
+        gate when NI < 100.  Velocity errors are in each attitude's own yaw
+        frame, so a constant heading error on a lane with no yaw source does
+        not count against it'''
+        dfreader = DFReader.DFReader_binary(path, zero_time_base=True)
+        att = []
+        upd = []
+        truth_yaw = []
+        truth = []
+        msgs = []
+        last5 = None
+        try:
+            while True:
+                m = dfreader.recv_match(type=['XKF1', 'XKF5', 'SIM', 'SIM2', 'MSG'])
+                if m is None:
+                    break
+                t = m.TimeUS * 1e-6
+                mtype = m.get_type()
+                if mtype == 'XKF1' and m.C == core:
+                    att.append((t, math.cos(math.radians(m.Roll)) * math.cos(math.radians(m.Pitch)),
+                                math.radians(m.Yaw), m.VN, m.VE, m.PN, m.PE))
+                elif mtype == 'XKF5' and m.C == core:
+                    key = (m.NI, m.FIX, m.FIY)
+                    if last5 is not None and key != last5:
+                        upd.append((t, m.NI))
+                    last5 = key
+                elif mtype == 'SIM':
+                    truth_yaw.append((t, math.radians(m.Yaw)))
+                elif mtype == 'SIM2':
+                    truth.append((t, m.VN, m.VE, m.PN, m.PE))
+                elif mtype == 'MSG':
+                    msgs.append((t, m.Message))
+        finally:
+            dfreader.close()
+
+        def at(series, t):
+            lo, hi = 0, len(series) - 1
+            if hi < 0 or series[0][0] > t:
+                return None
+            while lo < hi:
+                mid = (lo + hi + 1) // 2
+                if series[mid][0] <= t:
+                    lo = mid
+                else:
+                    hi = mid - 1
+            return series[lo]
+
+        def body(vn, ve, yaw):
+            return (vn * math.cos(yaw) + ve * math.sin(yaw), -vn * math.sin(yaw) + ve * math.cos(yaw))
+
+        def verr(t):
+            a = at(att, t)
+            b = at(truth, t)
+            y = at(truth_yaw, t)
+            if a is None or b is None or y is None:
+                return float('nan'), float('nan'), float('nan')
+            fa = body(a[3], a[4], a[2])
+            fb = body(b[1], b[2], y[1])
+            return (math.hypot(fa[0] - fb[0], fa[1] - fb[1]),
+                    math.hypot(a[3] - b[1], a[4] - b[2]),
+                    math.hypot(b[1], b[2]))
+
+        def displacement_error(t0, t1):
+            # the core's displacement against truth's, with its heading error at t0 taken out
+            a0, a1 = at(att, t0), at(att, t1)
+            b0, b1 = at(truth, t0), at(truth, t1)
+            y0 = at(truth_yaw, t0)
+            if None in (a0, a1, b0, b1, y0):
+                return float('nan')
+            dyaw = a0[2] - y0[1]
+            dn, de = b1[3] - b0[3], b1[4] - b0[4]
+            rn = dn * math.cos(dyaw) - de * math.sin(dyaw)
+            re_ = dn * math.sin(dyaw) + de * math.cos(dyaw)
+            return math.hypot((a1[5] - a0[5]) - rn, (a1[6] - a0[6]) - re_)
+
+        figures = []
+        for leg in legs:
+            # every stretch past the tilt limit in the leg; a run of flips has several
+            stretches = []
+            start = None
+            for t, c33, *_ in att:
+                if t < leg["t_cmd"] - 0.5 or t > leg["t_level"] + 3:
+                    start = None
+                    continue
+                if c33 <= 0.71:
+                    if start is None:
+                        start = t
+                elif start is not None:
+                    stretches.append((start, t))
+                    start = None
+            if len(stretches) == 0:
+                raise NotAchievedException("%s: never tilted past the flow limit" % leg["name"])
+            ts = stretches[0][0]
+            te = stretches[-1][1]
+            c33min = min(x[1] for x in att if ts <= x[0] <= te)
+            after = [u for u in upd if u[0] > te]
+            first = after[0] if after else None
+            first_pass = next((u for u in after if u[1] < 100), None)
+            rejects = 0
+            for u in after:
+                if u[1] < 100:
+                    break
+                rejects += 1
+            timeouts = len([x for x in msgs if ts - 0.1 <= x[0] <= te + 10 and
+                            "IMU%u stopped aiding" % core in x[1]])
+            v0 = verr(te)
+            # the lane's error as the leg began, to show it did not inherit the last leg's
+            vstart = verr(leg["t_cmd"])[0]
+            figures.append({
+                "leg": leg["name"],
+                "tilt_s": sum(b - a for a, b in stretches),
+                "stretches": len(stretches),
+                "c33min": c33min,
+                "verr_start": vstart,
+                "verr": v0[0],
+                "verr_ne": v0[1],
+                "speed": v0[2],
+                "first_dt": (first[0] - te) if first else float('nan'),
+                "first_ni": first[1] if first else -1,
+                "pass_dt": (first_pass[0] - te) if first_pass else float('nan'),
+                "rejects": rejects,
+                "verr2": verr(te + 2)[0],
+                "verr5": verr(te + 5)[0],
+                "verr10": verr(te + 10)[0],
+                "disp10": displacement_error(leg["t_cmd"], te + 10),
+                "timeouts": timeouts,
+            })
+        return figures
+
+    def OpticalFlowTiltRecovery(self):
+        '''measure how a flow lane recovers after a turn or flip withholds its flow'''
+        # Measurement harness, not a pass/fail check: core 0 on GPS flies the
+        # vehicle and core 1 on optical flow alone is compared with SITL truth
+        # after each leg.  Turns are banked 55 deg, past the 45 deg flow tilt
+        # limit, at 70 deg/s from an 11 m/s run-up; flips are FLIP mode from a
+        # run-up in ALT_HOLD.  The flow core's gyro has a 1% yaw scale error, and
+        # the legs are flown with and without a yaw source for that core, then
+        # with a 3% scale error on every gyro axis, which tilts the attitude
+        # the lane dead-reckons on through a turn as a real acro flight does.
+        # TILT_RECOVERY_TAG labels the CSV rows.
+        tag = os.environ.get("TILT_RECOVERY_TAG", "unlabelled")
+        csv_path = self.buildlogs_path("OpticalFlowTiltRecovery.csv")
+        rows = []
+        bank_deg = 55
+        turn_rate_degs = 70
+        target = {"att": None}
+
+        def send_target(mav, m):
+            if target["att"] is None or m.get_type() != 'ATTITUDE':
+                return
+            roll_deg, pitch_deg, yaw0, rate_degs, t0 = target["att"]
+            yaw = yaw0 + math.radians(rate_degs) * (m.time_boot_ms * 1e-3 - t0)
+            rate = math.radians(rate_degs)
+            self.mav.mav.set_attitude_target_send(
+                0, 1, 1, 0,
+                mavextra.euler_to_quat([math.radians(roll_deg), math.radians(pitch_deg), yaw]),
+                0,
+                rate * math.sin(math.radians(roll_deg)),
+                rate * math.cos(math.radians(roll_deg)),
+                0.5)
+
+        def wait_abs_roll(above_deg=None, below_deg=None, timeout=10):
+            tstart = self.get_sim_time_cached()
+            while self.get_sim_time_cached() - tstart < timeout:
+                m = self.assert_receive_message('ATTITUDE')
+                roll = abs(math.degrees(m.roll))
+                pitch = abs(math.degrees(m.pitch))
+                if above_deg is not None and roll > above_deg:
+                    return
+                if below_deg is not None and roll < below_deg and pitch < below_deg:
+                    return
+            raise NotAchievedException("roll did not pass %s/%s deg" % (above_deg, below_deg))
+
+        def settle(alt):
+            self.change_mode('LOITER')
+            self.wait_groundspeed(0, 1, timeout=60)
+            self.set_rc(3, 1800 if self.get_altitude(relative=True) < alt else 1200)
+            self.wait_altitude(alt - 1, alt + 1, relative=True, timeout=60)
+            self.set_rc(3, 1500)
+            self.wait_groundspeed(0, 1, timeout=60)
+            # long enough for a lane left wrong by the last leg to fuse or time out at rest
+            self.delay_sim_time(8, "flow lane settles")
+
+        def turn_leg(name, tilt_s):
+            self.change_mode('GUIDED')
+            yaw0 = self.assert_receive_message('ATTITUDE').yaw
+            target["att"] = (0, -40, yaw0, 0, self.get_sim_time_cached())
+            self.wait_groundspeed(11, 100, timeout=20)
+            t_cmd = self.get_sim_time_cached()
+            target["att"] = (bank_deg, 0, yaw0, turn_rate_degs, t_cmd)
+            self.delay_sim_time(tilt_s, "%s: banked turn" % name)
+            t_level = self.get_sim_time_cached()
+            yaw_now = self.assert_receive_message('ATTITUDE').yaw
+            target["att"] = (0, 0, yaw_now, 0, t_level)
+            self.delay_sim_time(12, "%s: level, flow lane recovers" % name)
+            target["att"] = None
+            return {"name": name, "t_cmd": t_cmd, "t_level": t_level}
+
+        def flip_leg(name, flips):
+            self.change_mode('ALT_HOLD')
+            self.set_rc(2, 1200)
+            self.wait_groundspeed(10, 100, timeout=20)
+            self.set_rc(2, 1500)
+            t_cmd = self.get_sim_time_cached()
+            for _ in range(flips):
+                for attempt in range(25):
+                    try:
+                        self.run_cmd_do_set_mode('FLIP', timeout=2)
+                        break
+                    except (NotAchievedException, AutoTestTimeoutException):
+                        self.delay_sim_time(0.2, "waiting to flip again")
+                wait_abs_roll(above_deg=100)
+                wait_abs_roll(below_deg=20)
+            t_level = self.get_sim_time_cached()
+            self.wait_mode('ALT_HOLD', timeout=10)
+            self.delay_sim_time(12, "%s: level, flow lane recovers" % name)
+            return {"name": name, "t_cmd": t_cmd, "t_level": t_level}
+
+        for yaw_name, yaw_source, gyro_scale in (("compass", 1, (0, 0, 1)),
+                                                 ("no yaw", 0, (0, 0, 1)),
+                                                 ("gyro 3%", 1, (3, 3, 3))):
+            self.context_push()
+            self.set_parameters({
+                "SIM_FLOW_ENABLE": 1,
+                "FLOW_TYPE": 10,
+                "SIM_TERRAIN": 0,
+                "EK3_SRC_OPTIONS": 8,
+                "EK3_SRC2_POSXY": 0,
+                "EK3_SRC2_VELXY": 5,
+                "EK3_SRC2_POSZ": 1,
+                "EK3_SRC2_VELZ": 0,
+                "EK3_SRC2_YAW": 1,
+                "ATC_ANGLE_MAX": 70,
+                "SIM_GYR2_SCALE_X": gyro_scale[0],
+                "SIM_GYR2_SCALE_Y": gyro_scale[1],
+                "SIM_GYR2_SCALE_Z": gyro_scale[2],
+            })
+            self.set_analog_rangefinder_parameters()
+            self.reboot_sitl()
+            self.takeoff(12, mode='LOITER')
+            # arming needs the cores' yaws to agree, so the yaw source goes once flying
+            self.set_parameter("EK3_SRC2_YAW", yaw_source)
+            self.install_message_hook_context(send_target)
+            legs = []
+            for alt, leg_list in ((12, (("turn 3s", turn_leg, 3),
+                                        ("turn 8s", turn_leg, 8),
+                                        ("turn 15s", turn_leg, 15),
+                                        ("flip x1", flip_leg, 1))),
+                                  (30, (("turn 3s", turn_leg, 3),
+                                        ("turn 8s", turn_leg, 8),
+                                        ("turn 15s", turn_leg, 15),
+                                        ("flip x1", flip_leg, 1),
+                                        ("flip x3", flip_leg, 3)))):
+                for name, kind, arg in leg_list:
+                    settle(alt)
+                    leg = kind("%s %um %s" % (yaw_name, alt, name), arg)
+                    legs.append(leg)
+            log_path = self.current_onboard_log_filepath()
+            self.change_mode('LOITER')
+            self.do_RTL()
+            self.context_pop()
+            self.reboot_sitl()
+            rows.extend(self.flow_tilt_recovery_figures(log_path, legs))
+
+        fields = ["leg", "tilt_s", "stretches", "c33min", "verr_start", "verr", "verr_ne", "speed",
+                  "first_dt", "first_ni", "pass_dt", "rejects", "verr2", "verr5", "verr10", "disp10", "timeouts"]
+        new_file = not os.path.exists(csv_path)
+        with open(csv_path, "a") as f:
+            if new_file:
+                f.write("tag," + ",".join(fields) + "\n")
+            for r in rows:
+                f.write(tag + "," + ",".join(
+                    ("%.3f" % r[k]) if isinstance(r[k], float) else str(r[k]) for k in fields) + "\n")
+        self.progress("%-26s %5s %2s %5s %6s %6s %6s %5s %5s %4s %5s %3s %6s %6s %6s %6s %2s" % (
+            "leg", "tilt", "n", "c33", "vstart", "verr", "verrNE", "spd", "1st", "NI", "pass", "rej",
+            "v+2", "v+5", "v+10", "disp10", "TO"))
+        for r in rows:
+            self.progress("%-26s %5.1f %2d %5.2f %6.2f %6.2f %6.2f %5.1f %5.2f %4d %5.2f %3d %6.2f %6.2f %6.2f %6.1f %2d" % (
+                r["leg"], r["tilt_s"], r["stretches"], r["c33min"], r["verr_start"], r["verr"], r["verr_ne"],
+                r["speed"], r["first_dt"], r["first_ni"], r["pass_dt"], r["rejects"], r["verr2"], r["verr5"],
+                r["verr10"], r["disp10"], r["timeouts"]))
+        self.progress("rows appended to %s (tag %s)" % (csv_path, tag))
+
     def OpticalFlowLimits(self):
         '''test EKF navigation limiting'''
         self.set_parameters({
@@ -19790,6 +20079,7 @@ class AutoTestCopter(vehicle_test_suite.TestSuite):
             self.OpticalFlow,
             self.OpticalFlowLimits,
             self.OpticalFlowTiltNoTimeout,
+            self.OpticalFlowTiltRecovery,
             self.BodyFrameOdom,
             self.RTLSpeed,
             self.MountYawVehicleForMountROI,
-- 
