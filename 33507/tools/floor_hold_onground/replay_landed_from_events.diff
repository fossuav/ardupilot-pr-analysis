 bool LogReader::handle_msg(const struct log_Format &f, uint8_t *msg) {
+    // EXPERIMENT (not for push): logs from before #35105 carry no landed flag, so take it
+    // from the vehicle's own landing events: LAND_COMPLETE 18, NOT_LANDED 28, DISARMED 11
+    if (f.type == ev_msg_type && f.length >= 12) {
+        const uint8_t id = msg[3 + 8];
+        if (id == 18 || id == 11) {
+            AP_DAL::replay_landed_override = 1;
+        } else if (id == 28) {
+            AP_DAL::replay_landed_override = 0;
+        }
+    }
     // emit the output as we receive it:
     AP::logger().WriteBlock(msg, f.length);
 
